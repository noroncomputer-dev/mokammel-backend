# =====================================================
# تنظیمات محیطی بک‌اند - در Render.com وارد کن
# =====================================================

# اتصال MongoDB Atlas (ضروری)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority

# پورت (Render خودش تنظیم می‌کند - همین 5000 کافی است)
PORT=5000

# محیط اجرا
NODE_ENV=production

# JWT Secrets (حتماً مقادیر قوی بگذار)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# آدرس فرانت (برای CORS - اختیاری چون origin: true داریم)
CLIENT_URL=https://mokammel.vercel.app

# Cloudinary برای آپلود تصاویر (اگر استفاده می‌کنی)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
